# Groq (Whisper transcription)
# Optional: you can also set this from the in-app Settings page, which is stored
# in your own Google Drive (Audio Diary/config.json) and takes precedence.
GROQ_API_KEY=

# Optional: override the Whisper model (default: whisper-large-v3).
# WHISPER_MODEL=whisper-large-v3

# Google OAuth (Google Cloud Console -> APIs & Services -> Credentials)
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# NextAuth
# Generate a secret with:  openssl rand -base64 32
NEXTAUTH_SECRET=
NEXTAUTH_URL=http://localhost:3000
